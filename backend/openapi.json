  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "HealthResponseDto": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok",
              "error"
            ],
            "example": "ok"
          },
          "database": {
            "type": "string",
            "enum": [
              "connected",
              "disconnected"
            ],
            "example": "connected"
          },
          "message": {
            "type": "string",
            "example": "Connection refused"
          }
        },
        "required": [
          "status",
          "database"
        ]
      },
      "CreateUserDto": {
        "type": "object",
        "properties": {
          "phone": {
            "type": "string",
            "example": "+380501234567"
          },
          "first_name": {
            "type": "string",
            "example": "Іван"
          },
          "last_name": {
            "type": "string",
            "example": "Петренко"
          },
          "password": {
            "type": "string",
            "example": "password123"
          },
          "role": {
            "type": "string",
            "example": "driver",
            "enum": [
              "admin",
              "driver"
            ]
          }
        },
        "required": [
          "phone",
          "first_name",
          "last_name",
          "password"
        ]
      },
      "PublicUserDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "number",
            "example": 1
          },
          "phone": {
            "type": "string",
            "example": "+380501234567"
          },
          "first_name": {
            "type": "string",
            "example": "Іван"
          },
          "last_name": {
            "type": "string",
            "example": "Петренко"
          },
          "role": {
            "type": "string",
            "enum": [
              "admin",
              "driver"
            ],
            "example": "driver"
          }
        },
        "required": [
          "id",
          "phone",
          "first_name",
          "last_name",
          "role"
        ]
      },
      "UserListItemDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "number",
            "example": 1
          },
          "phone": {
            "type": "string",
            "example": "+380501234567"
          },
          "first_name": {
            "type": "string",
            "example": "Іван"
          },
          "last_name": {
            "type": "string",
            "example": "Петренко"
          },
          "role": {
            "type": "string",
            "enum": [
              "admin",
              "driver"
            ],
            "example": "driver"
          },
          "created_at": {
            "type": "string",
            "example": "2024-01-01T00:00:00.000Z"
          }
        },
        "required": [
          "id",
          "phone",
          "first_name",
          "last_name",
          "role",
          "created_at"
        ]
      },
      "UpdateUserDto": {
        "type": "object",
        "properties": {
          "phone": {
            "type": "string",
            "example": "+380501234567"
          },
          "first_name": {
            "type": "string",
            "example": "Іван"
          },
          "last_name": {
            "type": "string",
            "example": "Петренко"
          },
          "password": {
            "type": "string",
            "example": "newPassword123"
          }
        }
      },
      "LoginDto": {
        "type": "object",
        "properties": {
          "phone": {
            "type": "string",
            "example": "+380501234567"
          },
          "password": {
            "type": "string",
            "example": "password123"
          }
        },
        "required": [
          "phone",
          "password"
        ]
      },
      "AuthResponseDto": {
        "type": "object",
        "properties": {
          "access_token": {
            "type": "string",
            "example": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
          },
          "user": {
            "$ref": "#/components/schemas/PublicUserDto"
          }
        },
        "required": [
          "access_token",
          "user"
        ]
      },
      "UpdateTripDto": {
        "type": "object",
        "properties": {}
      },
      "AddDriverDto": {
        "type": "object",
        "properties": {}
      },
      "UpdateSeatDto": {
        "type": "object",
        "properties": {}
      },
      "CreateParcelDto": {
        "type": "object",
        "properties": {}
      },
      "UpdateParcelDto": {
